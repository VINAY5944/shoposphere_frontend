# Authentication
VITE_AUTH_CUSTOMER_LOGIN_ENDPOINT=/auth/user/login
VITE_AUTH_ADMIN_LOGIN_ENDPOINT=/auth/admin/login
VITE_AUTH_ME_ENDPOINT=/user/me
VITE_AUTH_CUSTOMER_REGISTER_ENDPOINT=/users

# Customer catalogue
VITE_PRODUCTS_ENDPOINT=/products
VITE_CATEGORIES_ENDPOINT=/categories
VITE_ADMIN_PRODUCTS_ENDPOINT=/admin/products
VITE_ADMIN_DASHBOARD_ENDPOINT=/admin/dashboard
